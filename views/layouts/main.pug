doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || 'VN Typing - Luyện Gõ 10 Ngón Tiếng Việt'
    meta(name="description", content="Trang web luyện gõ 10 ngón Tiếng Việt chuyên sâu với hỗ trợ Telex, VNI, bàn phím ảo ANSI và bàn tay hướng dẫn 10 ngón.")

    //- Google Fonts: Inter & JetBrains Mono
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap", rel="stylesheet")

    //- Bootstrap 5 CSS CDN
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet")

    //- Tailwind CSS CDN
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                dark: '#1e1e2e',
                accent: '#e2b714'
              }
            }
          }
        }
      }

    //- Font Awesome CDN
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    //- Custom Application Stylesheet
    link(rel="stylesheet", href="/css/style.css")

    block head

  body
    //- Thanh điều hướng chung
    include ../partials/navbar.pug

    //- Nội dung chính từng trang
    main.flex-grow.py-6
      block content

    //- Footer
    footer.py-4.border-t.border-slate-800.mt-auto(style="background-color: var(--bg-secondary);")
      .container.mx-auto.px-4.text-center.text-sm.text-slate-400
        p.mb-1 VN Typing &copy; 2026 - Nền tảng luyện gõ 10 ngón chuẩn Tiếng Việt (Telex & VNI).
        p.text-xs.text-slate-500 Thiết kế tối ưu hóa tốc độ gõ phím và giảm thiểu lỗi chính tả.

    //- Bootstrap 5 JS Bundle CDN
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")

    //- Socket.io CDN
    script(src="/socket.io/socket.io.js")

    //- Global Script cho chuyển đổi Dark / Light Theme
    script.
      const themeToggleBtn = document.getElementById('btn-toggle-theme');
      if (themeToggleBtn) {
        const savedTheme = localStorage.getItem('vn_typing_theme');
        if (savedTheme === 'light') {
          document.body.classList.add('light-theme');
          updateThemeIcon(true);
        }

        themeToggleBtn.addEventListener('click', () => {
          const isLight = document.body.classList.toggle('light-theme');
          localStorage.setItem('vn_typing_theme', isLight ? 'light' : 'dark');
          updateThemeIcon(isLight);
        });

        function updateThemeIcon(isLight) {
          const icon = themeToggleBtn.querySelector('i');
          if (icon) {
            icon.className = isLight ? 'fa-solid fa-moon text-yellow-400' : 'fa-solid fa-sun text-yellow-400';
          }
        }
      }

    block scripts
