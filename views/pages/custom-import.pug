extends ../layouts/main.pug

block content
  .container.mx-auto.px-4.max-w-4xl
    .mb-8.text-center
      h1.text-3xl.font-extrabold.text-slate-100.mb-2
        i.fa-solid.fa-file-lines.mr-2(style="color: var(--accent);")
        | Tự Do Nhập & Quản Lý Văn Bản Luyện Gõ
      p.text-sm.text-slate-400 Dán bất kỳ đoạn văn bản Tiếng Việt nào hoặc tải lên tệp .txt. Hệ thống sẽ tự động chuẩn hóa Unicode NFC.

    .grid.grid-cols-1.md_grid-cols-3.gap-8
      //- Cột trái: Form nhập văn bản
      .md_col-span-2.p-6.rounded-2xl.border.border-slate-800(style="background-color: var(--bg-secondary);")
        h2.text-lg.font-bold.text-slate-100.mb-4.flex.items-center.gap-2
          i.fa-solid.fa-pen-to-square.text-yellow-400
          | Nhập văn bản mới

        form(action="/custom", method="POST")
          .mb-4
            label.block.text-xs.font-semibold.text-slate-300.mb-2(for="title") Tiêu đề văn bản (Tùy chọn)
            input#title(class="w-full px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm focus:outline-none focus:border-yellow-500",
              type="text",
              name="title",
              placeholder="VD: Bài thơ Tiếng Việt, Đoạn văn yêu thích..."
            )

          .mb-4
            .flex.items-center.justify-between.mb-2
              label.block.text-xs.font-semibold.text-slate-300(for="content") Nội dung văn bản
              label.cursor-pointer.text-xs.text-yellow-400.hover_underline.flex.items-center.gap-1
                i.fa-solid.fa-arrow-up-from-bracket
                span Tải tệp .txt lên
                input#file-upload.hidden(type="file", accept=".txt")

            textarea#content.w-full.px-4.py-3.rounded-xl.bg-slate-800.border.border-slate-700.text-slate-200.text-sm.focus_outline-none.focus_border-yellow-500.font-mono(
              name="content",
              rows="7",
              required,
              placeholder="Dán hoặc gõ nội dung văn bản tiếng Việt vào đây..."
            )

          .flex.items-center.justify-between
            span.text-xs.text-slate-500
              i.fa-solid.fa-shield-halved.mr-1
              | Tự động chuẩn hóa dấu ngoặc, gạch ngang và NFC
            button.px-6.py-3.rounded-xl.bg-yellow-500.hover_bg-yellow-400.text-slate-950.font-bold.text-sm.transition-all(type="submit")
              i.fa-solid.fa-play.mr-2
              | Bắt đầu Luyện tập

      //- Cột phải: Presets & Bài đã lưu
      .space-y-6
        //- Kho văn bản mẫu (Presets)
        .p-6.rounded-2xl.border.border-slate-800(style="background-color: var(--bg-secondary);")
          h2.text-base.font-bold.text-slate-100.mb-3.flex.items-center.gap-2
            i.fa-solid.fa-book-bookmark.text-yellow-400
            | Văn bản mẫu có sẵn
          .space-y-2
            if presets && presets.length > 0
              each preset in presets
                button.preset-btn.w-full.p-3.rounded-xl.bg-slate-800.hover_bg-slate-750.border.border-slate-700.text-left.transition-all(
                  type="button",
                  data-title=preset.title,
                  data-content=preset.content
                )
                  span.block.text-xs.font-bold.text-slate-200= preset.title
                  span.block.text-xs.text-slate-400.truncate.mt-1= preset.content

        //- Danh sách văn bản đã lưu của người dùng
        if savedTexts && savedTexts.length > 0
          .p-6.rounded-2xl.border.border-slate-800(style="background-color: var(--bg-secondary);")
            h2.text-base.font-bold.text-slate-100.mb-3.flex.items-center.gap-2
              i.fa-solid.fa-clock-rotate-left.text-yellow-400
              | Đã lưu gần đây
            .space-y-2
              each text in savedTexts
                a(class="block p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition-all no-underline", href=`/practice?customId=${text._id}`)
                  span.block.text-xs.font-semibold.text-slate-200= text.title
                  span.block.text-xs.text-slate-400.truncate= text.content

block scripts
  script.
    // Xử lý nạp văn bản từ Presets vào Form
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const titleInput = document.getElementById('title');
        const contentInput = document.getElementById('content');
        if (titleInput) titleInput.value = btn.getAttribute('data-title');
        if (contentInput) {
          contentInput.value = btn.getAttribute('data-content');
          contentInput.focus();
        }
      });
    });

    // Xử lý đọc file .txt
    const fileUpload = document.getElementById('file-upload');
    if (fileUpload) {
      fileUpload.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            const contentInput = document.getElementById('content');
            const titleInput = document.getElementById('title');
            if (contentInput) contentInput.value = event.target.result;
            if (titleInput && !titleInput.value) {
              titleInput.value = file.name.replace(/\.[^/.]+$/, "");
            }
          };
          reader.readAsText(file, 'UTF-8');
        }
      });
    }
