extends ../../layouts/main.pug

block content
  .container.mx-auto.px-4.max-w-md.py-12
    .p-8.rounded-3xl.border.border-slate-800.shadow-2xl(style="background-color: var(--bg-secondary);")
      .text-center.mb-6
        .w-12.h-12.rounded-2xl.bg-yellow-500.bg-opacity-10.text-yellow-400.mx-auto.flex.items-center.justify-center.text-2xl.mb-3
          i.fa-solid.fa-user-plus
        h1.text-2xl.font-extrabold.text-slate-100 Đăng Ký Tài Khoản
        p.text-xs.text-slate-400.mt-1 Bắt đầu hành trình rèn luyện 10 ngón tay phản xạ chuẩn xác

      if error
        .p-3.mb-4.rounded-xl.bg-red-500.bg-opacity-10.border.border-red-500.text-red-400.text-xs.text-center
          i(class="fa-solid fa-circle-exclamation mr-1")
          = error

      form(action="/register", method="POST", class="space-y-4")
        div
          label(class="block text-xs font-semibold text-slate-300 mb-1", for="username") Tên người dùng (Username)
          input#username(class="w-full px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm focus:outline-none focus:border-yellow-500",
            type="text",
            name="username",
            required,
            placeholder="VD: minh_vuong"
          )

        div
          label(class="block text-xs font-semibold text-slate-300 mb-1", for="email") Địa chỉ Email
          input#email(class="w-full px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm focus:outline-none focus:border-yellow-500",
            type="email",
            name="email",
            required,
            placeholder="name@example.com"
          )

        div
          label(class="block text-xs font-semibold text-slate-300 mb-1", for="password") Mật khẩu
          input#password(class="w-full px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm focus:outline-none focus:border-yellow-500",
            type="password",
            name="password",
            required,
            minlength="6",
            placeholder="Tối thiểu 6 ký tự"
          )

        div
          label(class="block text-xs font-semibold text-slate-300 mb-1", for="confirmPassword") Xác nhận mật khẩu
          input#confirmPassword(class="w-full px-4 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-200 text-sm focus:outline-none focus:border-yellow-500",
            type="password",
            name="confirmPassword",
            required,
            placeholder="Nhập lại mật khẩu"
          )

        button.w-full.py-3.rounded-xl.bg-yellow-500.hover_bg-yellow-400.text-slate-950.font-bold.text-sm.transition-all.mt-2(type="submit")
          | Đăng Ký

      .mt-6.pt-4.border-t.border-slate-800.text-center.text-xs.text-slate-400
        span Đã có tài khoản? 
        a.text-yellow-400.font-semibold.hover_underline(href="/login") Đăng nhập ngay
