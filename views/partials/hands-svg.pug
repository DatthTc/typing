.hands-svg-container
  //- BÀN TAY TRÁI (LEFT HAND)
  .flex.flex-col.items-center
    span.text-xs.font-semibold.text-slate-400.mb-2
      i.fa-solid.fa-hand-back-fist.mr-1
      | Tay Trái
    svg.hand-svg#svg-left-hand(width="220", height="160", viewBox="0 0 220 160", fill="none", xmlns="http://www.w3.org/2000/svg")
      //- Lòng bàn tay trái (Palm base)
      path(d="M 35 90 C 35 70, 185 70, 185 90 L 180 150 C 180 155, 40 155, 40 150 Z", fill="var(--bg-tertiary)", stroke="var(--key-border)", stroke-width="2")

      //- Ngón út trái (Left Pinky)
      g#hand-left-pinky.finger-group
        rect.finger-path(x="25", y="40", width="24", height="65", rx="12")
        text(x="37", y="30", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Út

      //- Ngón áp út trái (Left Ring)
      g#hand-left-ring.finger-group
        rect.finger-path(x="58", y="20", width="26", height="85", rx="13")
        text(x="71", y="12", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Áp

      //- Ngón giữa trái (Left Middle)
      g#hand-left-middle.finger-group
        rect.finger-path(x="93", y="10", width="28", height="95", rx="14")
        text(x="107", y="5", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Giữa

      //- Ngón trỏ trái (Left Index)
      g#hand-left-index.finger-group
        rect.finger-path(x="130", y="22", width="28", height="83", rx="14")
        text(x="144", y="14", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Trỏ

      //- Ngón cái trái (Left Thumb)
      g#hand-left-thumb.finger-group
        rect.finger-path(x="166", y="65", width="26", height="60", rx="13", transform="rotate(25 166 65)")
        text(x="195", y="60", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Cái

  //- BÀN TAY PHẢI (RIGHT HAND)
  .flex.flex-col.items-center
    span.text-xs.font-semibold.text-slate-400.mb-2
      i.fa-solid.fa-hand-back-fist.mr-1.fa-flip-horizontal
      | Tay Phải
    svg.hand-svg#svg-right-hand(width="220", height="160", viewBox="0 0 220 160", fill="none", xmlns="http://www.w3.org/2000/svg")
      //- Lòng bàn tay phải (Palm base)
      path(d="M 35 90 C 35 70, 185 70, 185 90 L 180 150 C 180 155, 40 155, 40 150 Z", fill="var(--bg-tertiary)", stroke="var(--key-border)", stroke-width="2")

      //- Ngón cái phải (Right Thumb)
      g#hand-right-thumb.finger-group
        rect.finger-path(x="28", y="65", width="26", height="60", rx="13", transform="rotate(-25 28 65)")
        text(x="25", y="60", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Cái

      //- Ngón trỏ phải (Right Index)
      g#hand-right-index.finger-group
        rect.finger-path(x="62", y="22", width="28", height="83", rx="14")
        text(x="76", y="14", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Trỏ

      //- Ngón giữa phải (Right Middle)
      g#hand-right-middle.finger-group
        rect.finger-path(x="99", y="10", width="28", height="95", rx="14")
        text(x="113", y="5", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Giữa

      //- Ngón áp út phải (Right Ring)
      g#hand-right-ring.finger-group
        rect.finger-path(x="136", y="20", width="26", height="85", rx="13")
        text(x="149", y="12", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Áp

      //- Ngón út phải (Right Pinky)
      g#hand-right-pinky.finger-group
        rect.finger-path(x="171", y="40", width="24", height="65", rx="12")
        text(x="183", y="30", text-anchor="middle", fill="var(--text-muted)", font-size="10", font-weight="bold") Út
